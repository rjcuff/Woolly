{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Woolly",
  "version": "0.10.0",
  "identifier": "com.usewoolly.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "Local memory for your AI tools",
    "copyright": "© 2026 Woolly",
    "externalBin": ["binaries/woolly"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
